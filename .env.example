# ============================================================
# StayCovered — environment template (commit this file, NOT .env)
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ---------- PayPal (sandbox only) ----------
# Dashboard -> Apps & Credentials -> Sandbox -> your app (linked to a US Business sandbox account)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Dashboard -> your app -> Webhooks -> add webhook -> copy its ID (needed to verify signatures)
PAYPAL_WEBHOOK_ID=

# ---------- AI ----------
# gemini (default, free tier via Google AI Studio) or anthropic
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Check the exact model name in Google AI Studio
GEMINI_MODEL=gemini-3.5-flash
# Optional: only if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Below this confidence, a check becomes "please verify manually"
AI_CONFIDENCE_THRESHOLD=0.7

# ---------- App ----------
# Public URL PayPal sends webhooks to (ngrok/cloudflared in dev, Render URL in prod)
PUBLIC_BASE_URL=
# Front-end URL allowed to call the back end (CORS)
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=
# Where uploaded chat screenshots and label photos are stored
FILE_STORAGE_PATH=./uploads
# Seller Protection signature-confirmation threshold in USD incl. shipping and tax (VERIFY in PayPal policy)
SIGNATURE_THRESHOLD_USD=750
# If true, dispute evidence is submitted automatically; if false, the seller clicks Submit
AUTO_SUBMIT_EVIDENCE=false

# ---------- Front end (safe to expose in the browser) ----------
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
